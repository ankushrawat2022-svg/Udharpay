# ============================================================================
# UdharPay Environment Configuration (.env.example)
# Copy this file to backend/.env (OUTSIDE your public webroot if possible)
# NEVER commit real passwords or payment keys to Git or frontend code.
# ============================================================================

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080/UdharPay/backend
FRONTEND_ORIGIN=http://localhost:5173

# MariaDB / MySQL Credentials (phpMyAdmin / AWebServer)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=udharpay_db
DB_USER=root
DB_PASS=

# Session & Signing Secrets (Generate random 64-char hex strings in production)
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
SESSION_TTL_SECONDS=86400

# Payment Mode: keep 'demo' until authorized RBI/NPCI payment partner onboarding is complete
PAYMENT_MODE=demo

# External Payment Partner Credentials (NOT CONFIGURED — Disabled in Demo Mode)
PAYMENT_PARTNER_PROVIDER=NOT_CONFIGURED
PAYMENT_PARTNER_KEY_ID=NOT_CONFIGURED
PAYMENT_PARTNER_KEY_SECRET=NOT_CONFIGURED
PAYMENT_WEBHOOK_SECRET=NOT_CONFIGURED

# SMS OTP Provider (NOT CONFIGURED — Demo OTP displayed in dev response only)
SMS_OTP_PROVIDER=NOT_CONFIGURED
SMS_OTP_API_KEY=NOT_CONFIGURED
